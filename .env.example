# Copy to .env (gitignored). Local demo values only — never real secrets in the repo.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-local-only
# Filled by scripts/setup-woo.sh (WordPress application password for user WP_ADMIN_USER)
WOO_APP_PASSWORD=
# Shared secret for Woo webhooks → n8n (HMAC-SHA256). Any long random string.
WOO_WEBHOOK_SECRET=
# HubSpot developer test account → Development > Keys > Service keys
HUBSPOT_SERVICE_KEY=
