      "parameters": {
        "jsCode": "const { createHmac, timingSafeEqual } = require('crypto');\n\n// ---- src/lib/webhook.js ----\n// WooCommerce webhook signature check (flow F2).\n// Woo sends X-WC-Webhook-Signature = base64(HMAC-SHA256(raw body, secret)).\n\nfunction verifyWooSignature(rawBody, signatureHeader, secret) {\n  if (!secret || typeof signatureHeader !== 'string') return false;\n  const expected = Buffer.from(createHmac('sha256', secret).update(rawBody, 'utf8').digest('base64'));\n  const received = Buffer.from(signatureHeader.trim());\n  return expected.length === received.length && timingSafeEqual(expected, received);\n}\n\n// Constant-time comparison for shared tokens (backfill webhook). Empty never matches.\nfunction safeEqual(received, expected) {\n  if (typeof received !== 'string' || typeof expected !== 'string' || !expected) return false;\n  const a = Buffer.from(received);\n  const b = Buffer.from(expected);\n  return a.length === b.length && timingSafeEqual(a, b);\n}\n\nconst item = $input.first();\nconst headers = item.json.headers ?? {};\nconst raw = item.binary?.data\n  ? (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8')\n  : JSON.stringify(item.json.body ?? {});\nconst body = item.json.body ?? {};\n\n// Woo pings the URL once when the webhook is saved (form-encoded webhook_id, no order).\nif (body.webhook_id && !body.id) return [{ json: { action: 'ping' } }];\n\nif (!verifyWooSignature(raw, headers['x-wc-webhook-signature'], $env.WOO_WEBHOOK_SECRET)) {\n  return [{ json: { action: 'reject', reason: 'invalid signature' } }];\n}\nconst order = JSON.parse(raw);\nreturn [{ json: { action: 'sync', topic: headers['x-wc-webhook-topic'], order, email: String(order.billing?.email ?? '').trim().toLowerCase() } }];"
      }
    },
