    {
      "id": "00000000-0000-4000-8000-000000000014",
      "name": "Chunk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        0
      ],
      "parameters": {
        "jsCode": "const { startChunk, chunkSize } = $('Config').first().json;\nconst all = $input.all().map((item) => item.json).filter((o) => o && o.id);\nconst emailOf = (o) => String(o.billing?.email ?? '').trim().toLowerCase();\nconst byEmail = new Map();\nfor (const o of all) byEmail.set(emailOf(o), [...(byEmail.get(emailOf(o)) ?? []), o]);\nconst chunks = [];\nfor (let i = 0; i * chunkSize < all.length; i++) {\n  if (i < startChunk) continue;\n  const orders = all.slice(i * chunkSize, (i + 1) * chunkSize);\n  const history = [...new Set(orders.map(emailOf))].flatMap((e) => byEmail.get(e) ?? []);\n  chunks.push({ json: { chunk: i, orders, history } });\n}\nreturn chunks;"
      }
    },
