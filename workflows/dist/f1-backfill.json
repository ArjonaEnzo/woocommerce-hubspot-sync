      "parameters": {
        "jsCode": "const runs = $input.all().map((item, i) => ({ chunk: $('Chunk').all()[i].json.chunk, ...item.json }));\nconst total = (k) => runs.reduce((n, r) => n + (r[k] ?? 0), 0);\nreturn [{ json: { chunks: runs.length, orders: total('orders'), deals: total('deals'), contacts: total('contacts'),\n  lineItems: total('lineItems'), ticketsCreated: total('ticketsCreated'), requests: total('requests'), runs } }];"
      }
    }
